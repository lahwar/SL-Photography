---
// Contract: no props. Uses heroPhoto + site (headline, intro) + person.name.
// Split layout on desktop, stacked on mobile (photo first). The photo is the page's LCP image.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { heroPhoto } from '../data/photos';
import { person, site } from '../data/site';

const [first, ...rest] = person.name.split(' ');
// Read dimensions from `clone`: touching any property on the image proxy makes Astro ship the original JPEG.
const original = ((heroPhoto.image as ImageMetadata & { clone?: ImageMetadata }).clone ?? heroPhoto.image).width;
const widths = [480, 800, 1200, 1800, 2400].filter((w) => w <= original);
if (!widths.includes(original) && original < 2400) widths.push(original);
---

<section class="hero" aria-label="Introduction">
  <div class="text">
    <p class="mono eyebrow">{site.name}</p>
    <div class="body">
      <h1 class="display name">
        {first}
        <span class="last">{rest.join(' ')}</span>
      </h1>
      <p class="display headline">{site.headline}</p>
      <p class="intro">{site.intro}</p>
    </div>
    <a class="mono enter" href="#salt">Enter <span aria-hidden="true">↓</span></a>
  </div>
  <div class="media" style={`--focal:${heroPhoto.focal ?? '50% 50%'}`}>
    <Picture
      src={heroPhoto.image}
      alt={heroPhoto.alt}
      widths={widths}
      sizes="(min-width: 60rem) 50vw, 100vw"
      formats={['avif']}
      fallbackFormat="webp"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
</section>

<style>
  .hero {
    display: grid;
  }

  .media {
    order: -1;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bg-raised);
  }

  .media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focal);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-8) var(--gutter) var(--space-12);
  }

  .eyebrow {
    color: var(--muted);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .name {
    font-size: var(--text-display);
  }

  .last {
    display: block;
  }

  .headline {
    font-size: var(--text-xl);
    font-style: italic;
  }

  .intro {
    max-width: var(--measure);
    color: var(--muted);
    font-size: var(--text-lg);
  }

  .enter {
    align-self: flex-start;
    padding-block: var(--space-3);
    color: var(--muted);
    text-decoration: none;
  }

  .enter:hover {
    color: var(--ember);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      min-height: calc(100svh - 4rem);
    }

    .media {
      order: 0;
      aspect-ratio: auto;
    }

    .text {
      justify-content: space-between;
      gap: var(--space-12);
      padding: var(--space-12) var(--gutter);
    }

    .body {
      gap: var(--space-8);
    }
  }
</style>
