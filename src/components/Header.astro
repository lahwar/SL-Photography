---
// Contract: no props. Sticky header: 'SL' wordmark, chapter links (I–V), ThemeToggle.
import ThemeToggle from './ThemeToggle.astro';
import { chapters } from '../data/chapters';

// Prefix with the site base so the links also work from /404.
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<header class="header">
  <div class="container bar">
    <a class="brand" href={`${base}#main`} aria-label="SL Photography, back to top">
      <span class="display mark" aria-hidden="true">SL</span>
      <span class="mono word" aria-hidden="true">Photography</span>
    </a>
    <nav class="nav" aria-label="Chapters">
      <ul class="chapters">
        {
          chapters.map((c) => (
            <li>
              <a href={`${base}#${c.id}`} aria-label={c.title}>
                <span class="mono numeral">{c.numeral}</span>
                <span class="title">{c.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--space-16);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: var(--space-2);
  }
  .brand {
    display: inline-flex;
    gap: var(--space-3);
    min-height: 2.75rem;
    align-items: center;
    text-decoration: none;
  }
  .mark {
    font-size: 1.75rem;
    letter-spacing: 0.02em;
  }
  .word {
    display: none;
    color: var(--muted);
  }
  .nav {
    display: flex;
    align-items: center;
  }
  .chapters {
    display: flex;
    padding: 0;
    list-style: none;
  }
  .chapters a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.75rem;
    padding-inline: var(--space-1);
    color: var(--muted);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .chapters a:hover {
    color: var(--ember);
  }
  .numeral {
    font-size: var(--text-sm);
  }
  .title {
    display: none;
    margin-left: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }
  @media (min-width: 36rem) {
    .word {
      display: inline;
    }
  }
  @media (min-width: 60rem) {
    .chapters a {
      padding-inline: var(--space-3);
    }
    .title {
      display: inline;
    }
    .nav {
      gap: var(--space-4);
    }
  }
</style>
