---
// Contract: no props. © year + person.name, SocialIcons, 'Back to top'.
import SocialIcons from './SocialIcons.astro';
import { person } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container row">
    <p class="mono copy">© {year} {person.name}</p>
    <SocialIcons />
    <a class="mono top" href="#main">Back to top <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: var(--space-6);
  }
  .row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .copy {
    color: var(--muted);
  }
  .top {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    color: var(--ink);
    text-decoration: none;
  }
  .top:hover {
    color: var(--ember);
  }
  @media (min-width: 48rem) {
    .row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
