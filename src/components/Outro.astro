---
// Contract: no props. Closing section: Instagram call to action using person.instagram.
import { person } from '../data/site';
---

<section class="outro" aria-labelledby="outro-title">
  <div class="container">
    <h2 id="outro-title" class="display line reveal">That's the roll — for now.</h2>
    <p class="note reveal">Every frame here was made by walking, waiting and paying attention. More lives on Instagram.</p>
    <a class="cta display reveal" href={person.instagram.url} rel="noopener" target="_blank">
      <span class="label">Say hello on Instagram — {person.instagram.handle}</span>
      <span class="visually-hidden">(opens in a new tab)</span>
      <span class="arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .outro {
    border-top: 1px solid var(--line);
    padding-block: var(--space-32);
  }
  .line {
    font-size: var(--text-display);
    font-style: italic;
    max-width: 14ch;
    text-wrap: balance;
  }
  .note {
    margin-top: var(--space-8);
    max-width: var(--measure);
    font-size: var(--text-lg);
    color: var(--muted);
  }
  .cta {
    display: inline-block;
    max-width: 100%;
    margin-top: var(--space-12);
    font-size: var(--text-xl);
    line-height: 1.2;
    text-decoration: underline;
    text-decoration-color: var(--ember);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    transition: color 200ms ease;
  }
  .cta:hover {
    color: var(--ember);
  }
  .arrow {
    display: inline-block;
    margin-left: 0.25em;
    font-family: var(--font-body);
    font-size: 0.8em;
    text-decoration: none;
    transition: transform 300ms var(--ease-out);
  }
  .cta:hover .arrow {
    transform: translate(0.15em, -0.15em);
  }
  @media (prefers-reduced-motion: reduce) {
    .arrow {
      transition: none;
    }
  }
</style>
