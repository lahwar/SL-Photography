---
// Contract: props { photos: Photo[] }.
// Justified rows, laid out at build time: photos keep their order and natural aspect ratio,
// every photo in a row shares one height, and each row fills the full width (no holes).
// `feature: 'wide'` gets a row to itself. Below 40rem the rows collapse into a single column.
import type { ImageMetadata } from 'astro';
import type { Photo as PhotoData } from '../data/photos';
import Photo from './Photo.astro';

interface Props {
  photos: PhotoData[];
}

const { photos } = Astro.props;

// Read dimensions from `clone`: touching any property on the image proxy makes Astro ship the original JPEG.
const aspect = (p: PhotoData) => {
  const { width, height } = (p.image as ImageMetadata & { clone?: ImageMetadata }).clone ?? p.image;
  return width / height;
};

// A row closes once its aspect ratios add up to TARGET (≈ 2.5 landscape-equivalents),
// so rows land around 500px tall on a wide screen.
const TARGET = 2.4;
const MAX_PER_ROW = 4;

type Item = { photo: PhotoData; ar: number };
const rows: Item[][] = [];
let current: Item[] = [];
const sum = (row: Item[]) => row.reduce((s, i) => s + i.ar, 0);

for (const photo of photos) {
  const item = { photo, ar: aspect(photo) };
  if (photo.feature === 'wide') {
    if (current.length) rows.push(current);
    rows.push([item]);
    current = [];
    continue;
  }
  current.push(item);
  if (sum(current) >= TARGET || current.length === MAX_PER_ROW) {
    rows.push(current);
    current = [];
  }
}
if (current.length) {
  // A short leftover joins the previous mixed row rather than standing alone and oversized.
  const prev = rows[rows.length - 1];
  if (sum(current) < TARGET / 2 && prev && prev.length > 1 && prev.length + current.length <= MAX_PER_ROW) {
    prev.push(...current);
  } else {
    rows.push(current);
  }
}

// Rendered width of each photo, so the browser picks the right file.
// Content is capped at 84rem (90rem container minus 2 × 3rem gutter).
const sizesFor = (share: number) =>
  `(min-width: 90rem) ${Math.round(share * 1344)}px, (min-width: 40rem) ${Math.round(share * 94)}vw, 100vw`;

const layout = rows.map((row) => {
  const total = sum(row);
  return {
    total,
    items: row.map(({ photo, ar }) => ({ photo, ar, sizes: sizesFor(ar / total) })),
  };
});
---

<div class="grid">
  {
    layout.map(({ total, items }) => (
      <ul class="row" role="list" style={`--total:${total.toFixed(4)}`}>
        {items.map(({ photo, ar, sizes }) => (
          <li class="cell" style={`--ar:${ar.toFixed(4)}`}>
            <Photo photo={photo} sizes={sizes} />
          </li>
        ))}
      </ul>
    ))
  }
</div>

<style>
  .grid {
    display: grid;
    row-gap: var(--space-8);
  }

  .row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    row-gap: var(--space-8);
  }

  .cell {
    min-width: 0;
  }

  @media (min-width: 40rem) {
    .grid {
      row-gap: var(--space-12);
    }

    .row {
      display: flex;
      gap: var(--grid-gap);
      /* A lone portrait would otherwise fill the width and tower over the page. */
      width: min(100%, calc(var(--total) * 82svh));
      margin-inline: auto;
    }

    .cell {
      /* Width proportional to aspect ratio ⇒ equal heights across the row. */
      flex: var(--ar) 1 0;
    }
  }
</style>
