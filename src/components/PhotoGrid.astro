---
// Contract: props { photos: Photo[] }. Editorial grid driven by aspect ratio + photo.feature.
import type { ImageMetadata } from 'astro';
import type { Photo as PhotoData } from '../data/photos';
import Photo from './Photo.astro';

interface Props {
  photos: PhotoData[];
}

const { photos } = Astro.props;

// Column spans on the 12-col (desktop) and 6-col (tablet) grids; single column below 40rem.
// Read dimensions from `clone`: touching any property on the image proxy makes Astro ship the original JPEG.
const layout = (p: PhotoData) => {
  const { width, height } = (p.image as ImageMetadata & { clone?: ImageMetadata }).clone ?? p.image;
  const portrait = width / height < 1;
  // Two rows tall. 4 cols (not 5) so it pairs with two 4-col portraits and every row sums to 12.
  if (p.feature === 'tall') return { cols: 4, rows: 2, tablet: 3 };
  if (p.feature === 'wide') return { cols: portrait ? 8 : 12, rows: 1, tablet: portrait ? 4 : 6 };
  if (p.feature === 'large') return { cols: 8, rows: 1, tablet: portrait ? 4 : 6 };
  return { cols: portrait ? 4 : 6, rows: 1, tablet: portrait ? 3 : 6 };
};

// Rendered width of a span, so the browser picks the right file.
// Content is capped at 84rem (90rem container minus 2 x 3rem gutter), and ~93% of the viewport at 60rem.
const sizesFor = (cols: number, tablet: number) =>
  `(min-width: 90rem) ${Math.round((cols / 12) * 1344)}px, ` +
  `(min-width: 60rem) ${Math.round((cols / 12) * 93)}vw, ` +
  `(min-width: 40rem) ${Math.round((tablet / 6) * 94)}vw, 100vw`;

const items = photos.map((photo) => {
  const l = layout(photo);
  return { photo, ...l, sizes: sizesFor(l.cols, l.tablet) };
});
---

<ul class="grid" role="list">
  {
    items.map(({ photo, cols, rows, tablet, sizes }) => (
      <li class="cell" style={`--cols:${cols};--rows:${rows};--tablet:${tablet}`}>
        <Photo photo={photo} sizes={sizes} />
      </li>
    ))
  }
</ul>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8) var(--grid-gap);
    align-items: start;
  }

  .cell {
    min-width: 0;
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-auto-flow: dense;
      row-gap: var(--space-12);
    }

    .cell {
      grid-column: span var(--tablet);
      grid-row: span var(--rows);
    }
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .cell {
      grid-column: span var(--cols);
    }
  }
</style>
